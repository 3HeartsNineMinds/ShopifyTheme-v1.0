{%- liquid
  # Prefer the theme's Logo setting, then fall back to the logo uploaded in
  # Shopify admin under Settings > Brand, then to the wordmark.
  assign brand_logo = settings.logo
  if brand_logo == blank
    assign brand_logo = shop.brand.logo
  endif
-%}
<header class="site-header">
  <div class="page-width site-header__inner">
    <div class="site-nav site-actions site-actions--left">
      <a class="instagram-brand-link" href="{{ settings.instagram_url | default: 'https://www.instagram.com/_nineminds_/' }}" target="_blank" rel="noopener" aria-label="Open Nine Minds on Instagram">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"/>
          <circle cx="17.2" cy="6.8" r="1.2" fill="currentColor"/>
        </svg>
      </a>
    </div>

    <a class="site-brand site-brand--center" href="{{ routes.root_url }}" aria-label="{{ shop.name }} home">
      {% if brand_logo != blank %}
        {{ brand_logo | image_url: width: 240 | image_tag: class: 'site-logo', loading: 'eager', alt: shop.name }}
      {% else %}
        NINE<span>MINDS</span>
      {% endif %}
    </a>

    <div class="site-nav site-actions site-actions--right">
      {% if section.settings.menu != blank %}
        <nav class="site-nav site-nav--inline" aria-label="Primary navigation">
          {% for link in section.settings.menu.links %}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        </nav>
      {% endif %}

      <a class="cart-link cart-link--prominent" href="{{ routes.cart_url }}" aria-label="View cart with {{ cart.item_count }} items">
        <span>Cart</span>
        <strong>{{ cart.item_count }}</strong>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu" }
  ]
}
{% endschema %}
