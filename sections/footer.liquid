<footer class="site-footer">
  <div class="site-footer__inner">
    <nav class="site-footer__nav" aria-label="Footer navigation">
      {%- for i in (1..4) -%}
        {%- liquid
          case i
            when 1
              assign label = section.settings.link_one_label
              assign url = section.settings.link_one_url
            when 2
              assign label = section.settings.link_two_label
              assign url = section.settings.link_two_url
            when 3
              assign label = section.settings.link_three_label
              assign url = section.settings.link_three_url
            when 4
              assign label = section.settings.link_four_label
              assign url = section.settings.link_four_url
          endcase
        -%}
        {%- if label != blank -%}
          <a class="site-footer__link" href="{{ url | default: routes.root_url }}">{{ label }}</a>
        {%- endif -%}
      {%- endfor -%}
    </nav>

    <p class="site-footer__legal">&copy;{{ 'now' | date: '%Y' }} {{ shop.name | upcase }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "paragraph", "content": "Each link points at a Shopify page. Create them under Content > Pages with matching handles." },
    { "type": "text", "id": "link_one_label", "label": "Link 1 label", "default": "FAQ" },
    { "type": "url", "id": "link_one_url", "label": "Link 1 URL" },
    { "type": "text", "id": "link_two_label", "label": "Link 2 label", "default": "SIZE GUIDE" },
    { "type": "url", "id": "link_two_url", "label": "Link 2 URL" },
    { "type": "text", "id": "link_three_label", "label": "Link 3 label", "default": "CONTACT US" },
    { "type": "url", "id": "link_three_url", "label": "Link 3 URL" },
    { "type": "text", "id": "link_four_label", "label": "Link 4 label", "default": "LEGAL SHIT" },
    { "type": "url", "id": "link_four_url", "label": "Link 4 URL" }
  ]
}
{% endschema %}
