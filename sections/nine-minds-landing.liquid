{%- liquid
  # Product shown in the hero card. Falls back to the 'hoodie' handle so the
  # card still renders before the setting is picked in the theme editor.
  assign drop_product = section.settings.drop_product
  if drop_product == blank
    assign drop_product = all_products['hoodie']
  endif

  # Wordmark artwork: theme-editor setting first, then Content > Files.
  assign wordmark = section.settings.wordmark
  assign wordmark_file_url = 'NineMindsLogoText.png' | file_url

  # Background art. Desktop and mobile are separate files (Background_desktop /
  # Background_mobile); each falls back to a picked image, then to a Content >
  # Files name. Whichever one is missing falls back to the other in CSS, so a
  # single file still covers both breakpoints.
  assign art_desktop = ''
  if section.settings.background_image_desktop != blank
    assign art_desktop = section.settings.background_image_desktop | image_url: width: 2400
  elsif section.settings.background_file_desktop != blank
    assign art_desktop = section.settings.background_file_desktop | file_url
  endif

  assign art_mobile = ''
  if section.settings.background_image_mobile != blank
    assign art_mobile = section.settings.background_image_mobile | image_url: width: 1400
  elsif section.settings.background_file_mobile != blank
    assign art_mobile = section.settings.background_file_mobile | file_url
  endif

  # Either side missing means the other covers both breakpoints.
  if art_desktop == blank
    assign art_desktop = art_mobile
  endif
  if art_mobile == blank
    assign art_mobile = art_desktop
  endif
-%}
<section class="nm-landing" id="top" style="--nm-art-opacity:{{ section.settings.art_opacity | default: 100 | divided_by: 100.0 }}{% if art_desktop != blank %};--nm-art-desktop:url('{{ art_desktop }}'){% endif %}{% if art_mobile != blank %};--nm-art-mobile:url('{{ art_mobile }}'){% endif %}">
  {%- if art_desktop != blank or art_mobile != blank -%}
    {%- comment -%}
      The image itself comes from --nm-art-desktop / --nm-art-mobile above; the
      breakpoint that picks between them lives in base.css and mobile-fixes.css.
    {%- endcomment -%}
    <div class="nm-landing__art" aria-hidden="true"></div>
  {%- endif -%}
  <div class="nm-grain" aria-hidden="true"></div>

  <div class="nm-hero">
    {%- comment -%}
      Static strapline. The rotation and the register message were removed.
      The register popup itself now lives in the footer (snippets/register-modal),
      so it is available on every template rather than only here.
    {%- endcomment -%}
    <p class="nm-eyebrow">
      <span class="nm-dot" aria-hidden="true"></span>
      <span class="nm-eyebrow__slot">
        <span class="nm-eyebrow__item is-active">{{ section.settings.eyebrow }}</span>
      </span>
    </p>

    <a class="nm-drop-card" data-ripple-link style="--nm-card-zoom:{{ section.settings.card_zoom | default: 100 | divided_by: 100.0 }};--nm-card-box-opacity:{{ section.settings.card_box_opacity | default: 0 | divided_by: 100.0 }};--nm-card-box-color:{{ section.settings.card_box_color | default: '#050505' }}" href="{{ drop_product.url | default: routes.all_products_collection_url }}" aria-label="{% if drop_product != blank %}View {{ drop_product.title }}{% else %}View the first drop{% endif %}">
      <span class="nm-drop-card__box" aria-hidden="true"></span>

      {%- if drop_product.featured_image -%}
        {{ drop_product.featured_image | image_url: width: 900 | image_tag: class: 'nm-drop-card__image', loading: 'eager', alt: drop_product.title }}
      {%- else -%}
        <span class="nm-product-placeholder"><span>NINE MINDS</span></span>
      {%- endif -%}

      {%- if section.settings.show_card_details -%}
        <span class="nm-drop-card__content">
          <span class="nm-drop-card__kicker">{{ section.settings.card_kicker }}</span>
          <strong>{% if drop_product != blank %}{{ drop_product.title }}{% else %}NINE MINDS HOODIE{% endif %}</strong>
          {%- if drop_product.price != blank -%}
            <span class="nm-drop-card__price">{{ drop_product.price | money }}</span>
          {%- endif -%}
          <small>{{ section.settings.card_cta }}</small>
        </span>
      {%- endif -%}
    </a>

    <h1 class="nm-wordmark">
      {%- if wordmark != blank -%}
        {{ wordmark | image_url: width: 1400 | image_tag: class: 'nm-wordmark__image', loading: 'eager', alt: shop.name }}
      {%- elsif wordmark_file_url != blank -%}
        {%- comment -%}
          A Content > Files URL carries no dimensions, so width/height cannot be
          emitted here. CSS reserves the box instead (see .nm-wordmark__image).
          Pick the image in the theme editor to get a proper responsive tag.
        {%- endcomment -%}
        {% # theme-check-disable ImgWidthAndHeight %}
        <img class="nm-wordmark__image" src="{{ wordmark_file_url }}" alt="{{ shop.name }}" loading="eager">
        {% # theme-check-enable ImgWidthAndHeight %}
      {%- else -%}
        NINE MINDS
      {%- endif -%}
    </h1>
  </div>

  {%- comment -%}
    Water warp for the product picture. theme.js animates the displacement
    scale on tap, then hands over to the view transition into the product page.
    The SVG must stay in the layout (not display:none) or Safari drops the
    filter reference.
  {%- endcomment -%}
  <svg class="nm-filter-defs" aria-hidden="true" focusable="false">
    <filter id="nm-water" x="-25%" y="-25%" width="150%" height="150%" color-interpolation-filters="sRGB">
      <feTurbulence type="fractalNoise" baseFrequency="0.010 0.016" numOctaves="2" seed="7" result="noise">
        <animate attributeName="baseFrequency" dur="6s" values="0.010 0.016;0.014 0.011;0.010 0.016" repeatCount="indefinite"/>
      </feTurbulence>
      <feDisplacementMap in="SourceGraphic" in2="noise" scale="0" xChannelSelector="R" yChannelSelector="G" data-water-map/>
    </filter>
  </svg>
</section>

{% schema %}
{
  "name": "Nine Minds landing",
  "settings": [
    { "type": "header", "content": "Artwork" },
    { "type": "image_picker", "id": "background_image_desktop", "label": "Background art - desktop" },
    { "type": "text", "id": "background_file_desktop", "label": "Background art filename - desktop", "default": "Background_desktop.png", "info": "Used only when no desktop art is picked above. Must match a file in Content > Files, including its extension." },
    { "type": "image_picker", "id": "background_image_mobile", "label": "Background art - mobile" },
    { "type": "text", "id": "background_file_mobile", "label": "Background art filename - mobile", "default": "Background_mobile.png", "info": "Shown at 880px and below. Used only when no mobile art is picked above. Leave blank to reuse the desktop art." },
    { "type": "range", "id": "art_opacity", "label": "Background art opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "image_picker", "id": "wordmark", "label": "Wordmark image (white artwork)", "info": "Defaults to NineMindsLogoText.png from Content > Files." },
    { "type": "header", "content": "Strapline" },
    { "type": "text", "id": "eyebrow", "label": "Message", "default": "ORDER NOW / 99 PIECES" },
    { "type": "header", "content": "Hero product" },
    { "type": "product", "id": "drop_product", "label": "Product card" },
    { "type": "checkbox", "id": "show_card_details", "label": "Show product details on the card", "default": true },
    { "type": "text", "id": "card_kicker", "label": "Card kicker", "default": "First drop" },
    { "type": "text", "id": "card_cta", "label": "Card call to action", "default": "Tap to view product" },
    { "type": "color", "id": "card_box_color", "label": "Card panel colour", "default": "#050505" },
    { "type": "range", "id": "card_box_opacity", "label": "Card panel opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 0, "info": "The panel behind the photo. Only visible where the photo is transparent - see the theme README." },
    { "type": "range", "id": "card_zoom", "label": "Image zoom", "min": 100, "max": 175, "step": 5, "unit": "%", "default": 100, "info": "Crops white margins baked into the product photo." }
  ],
  "presets": [{ "name": "Nine Minds landing" }]
}
{% endschema %}
