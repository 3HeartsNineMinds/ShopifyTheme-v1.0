{%- liquid
  # Product shown in the hero card. Falls back to the 'hoodie' handle so the
  # card still renders before the setting is picked in the theme editor.
  assign drop_product = section.settings.drop_product
  if drop_product == blank
    assign drop_product = all_products['hoodie']
  endif

  # Wordmark artwork: theme-editor setting first, then Content > Files.
  assign wordmark = section.settings.wordmark
  assign wordmark_file_url = 'NineMindsLogoText.png' | file_url

  # Background embroidery art: theme-editor setting first, then Content > Files.
  assign art_url = ''
  if section.settings.background_image != blank
    assign art_url = section.settings.background_image | image_url: width: 2400
  elsif section.settings.background_file != blank
    assign art_url = section.settings.background_file | file_url
  endif
-%}
<section class="nm-landing" id="top" style="--nm-art-opacity:{{ section.settings.art_opacity | divided_by: 100.0 }}">
  {%- if art_url != blank -%}
    <div class="nm-landing__art" aria-hidden="true" style="background-image:url('{{ art_url }}')"></div>
  {%- endif -%}
  <div class="nm-grain" aria-hidden="true"></div>

  <div class="nm-hero">
    {%- comment -%}
      Rotating strapline. theme.js alternates the items; the register message is
      a link, so it is kept clickable and rotation pauses on hover/focus.
    {%- endcomment -%}
    <p class="nm-eyebrow" data-eyebrow-rotator data-eyebrow-interval="{{ section.settings.rotate_seconds }}">
      <span class="nm-dot" aria-hidden="true"></span>
      <span class="nm-eyebrow__slot">
        <span class="nm-eyebrow__item is-active" data-eyebrow-item>{{ section.settings.eyebrow }}</span>
        <a class="nm-eyebrow__item nm-eyebrow__item--link" data-eyebrow-item href="{{ section.settings.register_url | default: routes.root_url }}">{{ section.settings.eyebrow_register }}</a>
      </span>
    </p>

    <a class="nm-drop-card" style="--nm-card-zoom:{{ section.settings.card_zoom | divided_by: 100.0 }};--nm-card-opacity:{{ section.settings.card_opacity | divided_by: 100.0 }}" href="{{ drop_product.url | default: routes.all_products_collection_url }}" aria-label="{% if drop_product != blank %}View {{ drop_product.title }}{% else %}View the first drop{% endif %}">
      {%- if drop_product.featured_image -%}
        {{ drop_product.featured_image | image_url: width: 900 | image_tag: class: 'nm-drop-card__image', loading: 'eager', alt: drop_product.title }}
      {%- else -%}
        <span class="nm-product-placeholder"><span>NINE MINDS</span></span>
      {%- endif -%}

      {%- if section.settings.show_card_details -%}
        <span class="nm-drop-card__content">
          <span class="nm-drop-card__kicker">{{ section.settings.card_kicker }}</span>
          <strong>{% if drop_product != blank %}{{ drop_product.title }}{% else %}NINE MINDS HOODIE{% endif %}</strong>
          {%- if drop_product.price != blank -%}
            <span class="nm-drop-card__price">{{ drop_product.price | money }}</span>
          {%- endif -%}
          <small>{{ section.settings.card_cta }}</small>
        </span>
      {%- endif -%}
    </a>

    <h1 class="nm-wordmark">
      {%- if wordmark != blank -%}
        {{ wordmark | image_url: width: 1400 | image_tag: class: 'nm-wordmark__image', loading: 'eager', alt: shop.name }}
      {%- elsif wordmark_file_url != blank -%}
        {%- comment -%}
          A Content > Files URL carries no dimensions, so width/height cannot be
          emitted here. CSS reserves the box instead (see .nm-wordmark__image).
          Pick the image in the theme editor to get a proper responsive tag.
        {%- endcomment -%}
        {% # theme-check-disable ImgWidthAndHeight %}
        <img class="nm-wordmark__image" src="{{ wordmark_file_url }}" alt="{{ shop.name }}" loading="eager">
        {% # theme-check-enable ImgWidthAndHeight %}
      {%- else -%}
        NINE MINDS
      {%- endif -%}
    </h1>
  </div>
</section>

{% schema %}
{
  "name": "Nine Minds landing",
  "settings": [
    { "type": "header", "content": "Artwork" },
    { "type": "image_picker", "id": "background_image", "label": "Background art" },
    { "type": "text", "id": "background_file", "label": "Background art filename", "default": "WEBSITE_OCTOPUS_ART_EMBROIDERY.png", "info": "Used only when no background art is picked above. Must match a file in Content > Files, including its extension." },
    { "type": "range", "id": "art_opacity", "label": "Background art opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "image_picker", "id": "wordmark", "label": "Wordmark image (white artwork)", "info": "Defaults to NineMindsLogoText.png from Content > Files." },
    { "type": "header", "content": "Strapline" },
    { "type": "text", "id": "eyebrow", "label": "Message one", "default": "ORDER NOW / FIRST DROP / 99 PIECES" },
    { "type": "text", "id": "eyebrow_register", "label": "Message two (link)", "default": "REGISTER FOR 15% OFF" },
    { "type": "url", "id": "register_url", "label": "Message two link" },
    { "type": "range", "id": "rotate_seconds", "label": "Seconds per message", "min": 2, "max": 12, "step": 1, "unit": "s", "default": 4 },
    { "type": "header", "content": "Hero product" },
    { "type": "product", "id": "drop_product", "label": "Product card" },
    { "type": "checkbox", "id": "show_card_details", "label": "Show product details on the card", "default": true },
    { "type": "text", "id": "card_kicker", "label": "Card kicker", "default": "First drop" },
    { "type": "text", "id": "card_cta", "label": "Card call to action", "default": "Tap to view product" },
    { "type": "range", "id": "card_opacity", "label": "Image opacity", "min": 20, "max": 100, "step": 5, "unit": "%", "default": 70, "info": "Lower values let the background artwork show through the product photo." },
    { "type": "range", "id": "card_zoom", "label": "Image zoom", "min": 100, "max": 175, "step": 5, "unit": "%", "default": 100, "info": "Crops white margins baked into the product photo." }
  ],
  "presets": [{ "name": "Nine Minds landing" }]
}
{% endschema %}
