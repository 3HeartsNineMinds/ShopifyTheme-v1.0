{%- liquid
  # ---- SKU and material -----------------------------------------------
  # Both are product level metafields, read through the documented
  # metafields[namespace][key] path. The settings take "namespace.key" so a
  # different store can point them elsewhere without a code change.
  assign sku_path = section.settings.sku_metafield | default: 'custom.sku' | split: '.'
  assign product_sku = product.metafields[sku_path[0]][sku_path[1]].value

  assign material_path = section.settings.material_metafield | default: 'custom.material' | split: '.'
  assign product_material = product.metafields[material_path[0]][material_path[1]].value

  # ---- Size guide measurements ----------------------------------------
  # The measurements live on variant metafields. On this store they are
  # namespace "custom" with keys prefixed "size_guide_", which is what Shopify
  # generates from definition names like "Size_Guide:Height".
  #
  # Liquid cannot push to an array, so rows are captured into a delimited
  # string and split back out: one entry per measurement, "Label::namespace::key".
  # uniq collapses repeats across variants, sort_natural alphabetises by label.
  #
  # Two collectors run and merge, because only the first is guaranteed by the
  # Liquid docs:
  #   1. The keys listed in the settings, read with the documented
  #      metafields[namespace][key] syntax.
  #   2. Auto-discovery, which walks the namespace and keeps anything carrying
  #      the prefix, so measurements added later appear without a code change.
  #      Enumerating metafields is undocumented, hence the belt and braces.
  assign sg_namespace = section.settings.size_guide_namespace | default: 'custom'
  assign sg_prefix = section.settings.size_guide_prefix | default: 'size_guide'

  capture sg_listed_raw
    assign sg_listed = section.settings.size_guide_keys | split: ','
    for sg_entry in sg_listed
      assign sg_key = sg_entry | strip
      assign sg_entry_ns = sg_namespace
      # An entry may carry its own namespace, e.g. custom.size_guide_height.
      if sg_key contains '.'
        assign sg_key_parts = sg_key | split: '.'
        assign sg_entry_ns = sg_key_parts[0] | strip
        assign sg_key = sg_key_parts[1] | strip
      endif
      if sg_key != blank
        assign sg_label = sg_key | replace: 'Size_Guide:', '' | replace: 'size_guide:', '' | replace: 'Size_Guide_', '' | replace: 'size_guide_', '' | replace: '_', ' ' | replace: '-', ' ' | strip | capitalize
        echo sg_label
        echo '::'
        echo sg_entry_ns
        echo '::'
        echo sg_key
        echo '||'
      endif
    endfor
  endcapture

  capture sg_found_raw
    for variant in product.variants
      for field in variant.metafields[sg_namespace]
        assign sg_key = field.first
        assign sg_probe = sg_key | downcase | replace: '-', '_' | replace: ':', '_' | replace: ' ', '_'
        if sg_probe contains sg_prefix
          assign sg_label = sg_key | replace: 'Size_Guide:', '' | replace: 'size_guide:', '' | replace: 'Size_Guide_', '' | replace: 'size_guide_', '' | replace: '_', ' ' | replace: '-', ' ' | strip | capitalize
          echo sg_label
          echo '::'
          echo sg_namespace
          echo '::'
          echo sg_key
          echo '||'
        endif
      endfor
    endfor
  endcapture

  assign sg_raw = sg_listed_raw | append: sg_found_raw
  assign sg_rows = sg_raw | split: '||' | uniq | sort_natural

  assign has_size_guide = false
  if sg_rows.size > 0 or section.settings.size_guide_debug
    assign has_size_guide = true
  endif
-%}
<section class="section product-section nm-surface" data-product-section>
  {%- comment -%} Same grain overlay the landing page uses, so the backgrounds match. {%- endcomment -%}
  <div class="nm-grain" aria-hidden="true"></div>

  <div class="page-width product-layout">
    <div class="product-media-panel">
      <div class="product-media-gallery" aria-label="Product photos">
        {% assign image_count = product.images.size %}

        {% if image_count > 0 %}
          {% for image in product.images %}
            <input
              class="product-media-toggle"
              type="radio"
              name="product-media-{{ section.id }}"
              id="product-media-{{ section.id }}-{{ forloop.index }}"
              {% if forloop.first %}checked{% endif %}
            >
          {% endfor %}

          <div class="product-media-slides">
            {% for image in product.images %}
              {% if forloop.last %}
                {% assign next_index = 1 %}
              {% else %}
                {% assign next_index = forloop.index | plus: 1 %}
              {% endif %}

              <div class="product-media-slide product-media-slide--{{ forloop.index }}">
                {{ image | image_url: width: 1400 | image_tag: class: 'media product-media', loading: 'eager', alt: product.title }}

                {% if image_count > 1 %}
                  <label class="product-media-next" for="product-media-{{ section.id }}-{{ next_index }}" aria-label="Show next product photo">
                    Next photo
                    <span aria-hidden="true">→</span>
                  </label>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% elsif product.featured_image %}
          <div class="product-media-slides">
            <div class="product-media-slide product-media-slide--1 is-visible">
              {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'media product-media', loading: 'eager', alt: product.title }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="product-info-panel">
      <p class="section-kicker">Nine Minds piece</p>
      <h1 class="section-title product-title">{{ product.title }}</h1>

      {%- comment -%}
        The SKU takes the slot the price used to hold. Per-variant prices are
        still on the size options, so nothing is lost by dropping it here.
        The description has moved below the size guide.
      {%- endcomment -%}
      {%- if product_sku != blank -%}
        <p class="product-sku"><span class="product-sku__label">SKU:</span> <span class="product-sku__value">{{ product_sku }}</span></p>
      {%- endif -%}

      {% form 'product', product, data-cart-add: true, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {% unless product.has_only_default_variant %}
          <fieldset class="variant-picker" data-variant-picker>
            <legend>Choose size</legend>
            <div class="variant-options">
              {% for variant in product.variants %}
                <label class="variant-option {% unless variant.available %}variant-option--sold-out{% endunless %}">
                  <input
                    type="radio"
                    name="variant_choice"
                    value="{{ variant.id }}"
                    data-variant-input
                    data-price="{{ variant.price | money }}"
                    data-available="{{ variant.available }}"
                    {% if variant.id == product.selected_or_first_available_variant.id %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <span class="variant-option__content">
                    <span class="variant-option__title">{{ variant.title }}</span>
                    <span class="variant-option__price">{{ variant.price | money }}</span>
                  </span>
                </label>
              {% endfor %}
            </div>

            {%- if has_size_guide -%}
              <button class="size-guide-link" type="button" data-size-guide-open>Size guide</button>
            {%- endif -%}
          </fieldset>
        {% endunless %}

        {%- comment -%}
          Details block: one label, then the material and the description as
          plain lines beneath it. Lives in the right-hand column under the
          size guide.
        {%- endcomment -%}
        {%- if product_material != blank or product.description != blank -%}
          <div class="product-details">
            <p class="product-details__label">Details:</p>

            {%- if product_material != blank -%}
              <p class="product-details__material">{{ product_material }}</p>
            {%- endif -%}

            {%- if product.description != blank -%}
              <div class="rte product-details__description">{{ product.description }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}

        <div class="product-actions">
          <button class="button product-submit" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-to-cart>
            {% if product.selected_or_first_available_variant.available %}Add to basket{% else %}Sold out{% endif %}
          </button>
        </div>
      {% endform %}
    </div>
  </div>

  {%- comment -%}
    Size guide popup. Native <dialog>, so focus trapping and Esc come free;
    theme.js handles the open/close and the older-Safari [open] fallback.
  {%- endcomment -%}
  {%- if has_size_guide -%}
    <dialog class="size-guide-modal" data-size-guide aria-label="{{ product.title | escape }} size guide">
      <div class="size-guide-modal__panel">
        <button class="size-guide-modal__close" type="button" data-size-guide-close aria-label="Close size guide">&times;</button>

        <h2 class="size-guide-modal__heading">{{ product.title }} Size Guide</h2>
        <p class="size-guide-modal__note">All sizes are in cm</p>

        {%- if section.settings.size_guide_debug -%}
          {%- comment -%}
            Diagnostic only. Prints what Liquid can actually see on the first
            variant, so the real namespace and keys can be read off the page.
            Turn it off in the section settings once the table is right.
          {%- endcomment -%}
          <pre class="size-guide-debug">{{ product.variants.first.metafields | json }}</pre>
        {%- endif -%}

        {%- if sg_rows.size > 0 -%}
          <div class="size-guide-table-wrap">
            <table class="size-guide-table">
              <thead>
                <tr>
                  <th scope="col">Measurement</th>
                  {%- for variant in product.variants -%}
                    <th scope="col">{{ variant.title }}</th>
                  {%- endfor -%}
                </tr>
              </thead>
              <tbody>
                {%- for row in sg_rows -%}
                  {%- liquid
                    assign row_parts = row | split: '::'
                    assign row_label = row_parts[0]
                    assign row_namespace = row_parts[1]
                    assign row_key = row_parts[2]
                  -%}
                  <tr>
                    <th scope="row">{{ row_label }}</th>
                    {%- for variant in product.variants -%}
                      {%- liquid
                        assign cell = variant.metafields[row_namespace][row_key].value
                        assign cell_out = cell | default: '—'
                        # number_decimal returns "71.0"; drop the dead decimal
                        # so a whole number reads as 71 next to a real 60.5.
                        assign cell_parts = cell | split: '.'
                        if cell_parts.size == 2
                          if cell_parts[1] == '0'
                            assign cell_out = cell_parts[0]
                          endif
                        endif
                      -%}
                      <td>{{ cell_out }}</td>
                    {%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}

        {%- if sg_rows.size == 0 -%}
          <p class="size-guide-modal__note">No measurements found for this product.</p>
        {%- endif -%}
      </div>
    </dialog>
  {%- endif -%}
</section>

{{ 'product.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "header", "content": "Product details" },
    { "type": "text", "id": "sku_metafield", "label": "SKU metafield", "default": "custom.sku", "info": "Namespace and key of the product metafield shown under the title, in place of the price." },
    { "type": "text", "id": "material_metafield", "label": "Material metafield", "default": "custom.material", "info": "Namespace and key of the product metafield shown under the size guide." },
    { "type": "header", "content": "Size guide" },
    { "type": "text", "id": "size_guide_namespace", "label": "Measurement metafield namespace", "default": "custom", "info": "The namespace half of the variant metafield. Definitions named Size_Guide:Height land in custom." },
    { "type": "text", "id": "size_guide_prefix", "label": "Measurement key prefix", "default": "size_guide", "info": "Only keys containing this are treated as measurements, so the rest of the namespace is ignored." },
    { "type": "text", "id": "size_guide_keys", "label": "Measurement keys", "default": "size_guide_chest, size_guide_height, size_guide_height_inc_hood, size_guide_waist", "info": "Comma separated. Prefix an entry with its own namespace if it differs, e.g. custom.size_guide_height. Rows found automatically are merged in, so a new measurement appears without editing this." },
    { "type": "checkbox", "id": "size_guide_debug", "label": "Show metafield debug info", "default": false, "info": "Prints the raw metafields of the first variant inside the popup so the namespace and keys can be confirmed. Turn off once the table is correct." }
  ]
}
{% endschema %}
