{%- liquid
  # Size guide artwork: theme-editor setting first, then a Content > Files name.
  assign size_guide_src = ''
  if section.settings.size_guide_image != blank
    assign size_guide_src = section.settings.size_guide_image | image_url: width: 1600
  elsif section.settings.size_guide_file != blank
    assign size_guide_src = section.settings.size_guide_file | file_url
  endif

  # ---- Size guide measurements ----------------------------------------
  # Rows come from per-variant metafields. Liquid cannot push to an array, so
  # they are captured into a delimited string and split back out: one entry per
  # measurement, as "Label::namespace::key". uniq collapses the repeats across
  # variants, sort_natural alphabetises by label.
  #
  # Two ways in, because only the first is guaranteed by the Liquid docs:
  #   1. The keys listed in the section settings, read with the documented
  #      metafields[namespace][key] syntax. Always works.
  #   2. Auto-discovery, which walks the metafields object. Convenient when it
  #      works, but enumerating namespaces is undocumented behaviour.
  assign sg_namespace = section.settings.size_guide_namespace | default: 'Size_Guide'
  assign sg_raw = ''

  # -- 1. Explicit list, e.g. "Height, Chest, Sleeve".
  if section.settings.size_guide_keys != blank
    assign sg_listed = section.settings.size_guide_keys | split: ','
    capture sg_raw
      for sg_entry in sg_listed
        assign sg_key = sg_entry | strip
        assign sg_entry_ns = sg_namespace
        # An entry may carry its own namespace, e.g. custom.size_guide_height.
        if sg_key contains '.'
          assign sg_key_parts = sg_key | split: '.'
          assign sg_entry_ns = sg_key_parts[0] | strip
          assign sg_key = sg_key_parts[1] | strip
        endif
        if sg_key != blank
          assign sg_label = sg_key | replace: 'Size_Guide:', '' | replace: 'size_guide:', '' | replace: 'Size_Guide_', '' | replace: 'size_guide_', '' | replace: '_', ' ' | replace: '-', ' ' | strip | capitalize
          echo sg_label
          echo '::'
          echo sg_entry_ns
          echo '::'
          echo sg_key
          echo '||'
        endif
      endfor
    endcapture
  endif

  # -- 2. Auto-discovery: the named namespace first, then a sweep of every
  #       namespace for anything that looks like a size guide field.
  if sg_raw == blank
    capture sg_raw
      for variant in product.variants
        for field in variant.metafields[sg_namespace]
          assign sg_key = field.first
          assign sg_label = sg_key | replace: 'Size_Guide:', '' | replace: 'size_guide:', '' | replace: 'Size_Guide_', '' | replace: 'size_guide_', '' | replace: '_', ' ' | replace: '-', ' ' | strip | capitalize
          echo sg_label
          echo '::'
          echo sg_namespace
          echo '::'
          echo sg_key
          echo '||'
        endfor
      endfor
    endcapture
  endif

  if sg_raw == blank
    capture sg_raw
      for variant in product.variants
        for sg_group in variant.metafields
          assign sg_group_name = sg_group.first
          assign sg_group_probe = sg_group_name | downcase | replace: '-', '_' | replace: ':', '_' | replace: ' ', '_'
          for field in sg_group.last
            assign sg_key = field.first
            assign sg_key_probe = sg_key | downcase | replace: '-', '_' | replace: ':', '_' | replace: ' ', '_'
            assign sg_hit = false
            if sg_group_probe contains 'size_guide'
              assign sg_hit = true
            endif
            if sg_key_probe contains 'size_guide'
              assign sg_hit = true
            endif
            if sg_hit
              assign sg_label = sg_key | replace: 'Size_Guide:', '' | replace: 'size_guide:', '' | replace: 'Size_Guide_', '' | replace: 'size_guide_', '' | replace: '_', ' ' | replace: '-', ' ' | strip | capitalize
              echo sg_label
              echo '::'
              echo sg_group_name
              echo '::'
              echo sg_key
              echo '||'
            endif
          endfor
        endfor
      endfor
    endcapture
  endif

  assign sg_rows = sg_raw | split: '||' | uniq | sort_natural

  assign has_size_guide = false
  if sg_rows.size > 0 or size_guide_src != blank or section.settings.size_guide_debug
    assign has_size_guide = true
  endif
-%}
<section class="section product-section nm-surface" data-product-section>
  {%- comment -%} Same grain overlay the landing page uses, so the backgrounds match. {%- endcomment -%}
  <div class="nm-grain" aria-hidden="true"></div>

  <div class="page-width product-layout">
    <div class="product-media-panel">
      <div class="product-media-gallery" aria-label="Product photos">
        {% assign image_count = product.images.size %}

        {% if image_count > 0 %}
          {% for image in product.images %}
            <input
              class="product-media-toggle"
              type="radio"
              name="product-media-{{ section.id }}"
              id="product-media-{{ section.id }}-{{ forloop.index }}"
              {% if forloop.first %}checked{% endif %}
            >
          {% endfor %}

          <div class="product-media-slides">
            {% for image in product.images %}
              {% if forloop.last %}
                {% assign next_index = 1 %}
              {% else %}
                {% assign next_index = forloop.index | plus: 1 %}
              {% endif %}

              <div class="product-media-slide product-media-slide--{{ forloop.index }}">
                {{ image | image_url: width: 1400 | image_tag: class: 'media product-media', loading: 'eager', alt: product.title }}

                {% if image_count > 1 %}
                  <label class="product-media-next" for="product-media-{{ section.id }}-{{ next_index }}" aria-label="Show next product photo">
                    Next photo
                    <span aria-hidden="true">→</span>
                  </label>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% elsif product.featured_image %}
          <div class="product-media-slides">
            <div class="product-media-slide product-media-slide--1 is-visible">
              {{ product.featured_image | image_url: width: 1400 | image_tag: class: 'media product-media', loading: 'eager', alt: product.title }}
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="product-info-panel">
      <p class="section-kicker">Nine Minds piece</p>
      <h1 class="section-title product-title">{{ product.title }}</h1>

      <p class="price product-price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</p>

      {% if product.description != blank %}
        <div class="rte product-description">{{ product.description }}</div>
      {% endif %}

      {% form 'product', product, data-cart-add: true, class: 'product-form' %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}" data-variant-id>

        {% unless product.has_only_default_variant %}
          <fieldset class="variant-picker" data-variant-picker>
            <legend>Choose size</legend>
            <div class="variant-options">
              {% for variant in product.variants %}
                <label class="variant-option {% unless variant.available %}variant-option--sold-out{% endunless %}">
                  <input
                    type="radio"
                    name="variant_choice"
                    value="{{ variant.id }}"
                    data-variant-input
                    data-price="{{ variant.price | money }}"
                    data-available="{{ variant.available }}"
                    {% if variant.id == product.selected_or_first_available_variant.id %}checked{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                  <span class="variant-option__content">
                    <span class="variant-option__title">{{ variant.title }}</span>
                    <span class="variant-option__price">{{ variant.price | money }}</span>
                  </span>
                </label>
              {% endfor %}
            </div>

            {%- if has_size_guide -%}
              <button class="size-guide-link" type="button" data-size-guide-open>Size guide</button>
            {%- endif -%}
          </fieldset>
        {% endunless %}

        <div class="product-actions">
          <button class="button product-submit" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %} data-add-to-cart>
            {% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}
          </button>
          <a class="button button--secondary" href="{{ routes.cart_url }}">View cart</a>
        </div>
      {% endform %}
    </div>
  </div>

  {%- comment -%}
    Size guide popup. Native <dialog>, so focus trapping and Esc come free;
    theme.js handles the open/close and the older-Safari [open] fallback.
  {%- endcomment -%}
  {%- if has_size_guide -%}
    <dialog class="size-guide-modal" data-size-guide aria-label="{{ product.title | escape }} size guide">
      <div class="size-guide-modal__panel">
        <button class="size-guide-modal__close" type="button" data-size-guide-close aria-label="Close size guide">&times;</button>

        <h2 class="size-guide-modal__heading">{{ product.title }} Size Guide</h2>
        <p class="size-guide-modal__note">All sizes are in cm</p>

        {%- if section.settings.size_guide_debug -%}
          {%- comment -%}
            Diagnostic only. Prints what Liquid can actually see on the first
            variant, so the real namespace and keys can be read off the page.
            Turn it off in the section settings once the table is right.
          {%- endcomment -%}
          <pre class="size-guide-debug">{{ product.variants.first.metafields | json }}</pre>
        {%- endif -%}

        {%- if sg_rows.size > 0 -%}
          <div class="size-guide-table-wrap">
            <table class="size-guide-table">
              <thead>
                <tr>
                  <th scope="col">Measurement</th>
                  {%- for variant in product.variants -%}
                    <th scope="col">{{ variant.title }}</th>
                  {%- endfor -%}
                </tr>
              </thead>
              <tbody>
                {%- for row in sg_rows -%}
                  {%- liquid
                    assign row_parts = row | split: '::'
                    assign row_label = row_parts[0]
                    assign row_namespace = row_parts[1]
                    assign row_key = row_parts[2]
                  -%}
                  <tr>
                    <th scope="row">{{ row_label }}</th>
                    {%- for variant in product.variants -%}
                      <td>{{ variant.metafields[row_namespace][row_key].value | default: '—' }}</td>
                    {%- endfor -%}
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
          </div>
        {%- endif -%}

        {%- if sg_rows.size == 0 and size_guide_src == blank -%}
          <p class="size-guide-modal__note">No measurements found for this product.</p>
        {%- endif -%}

        {%- if size_guide_src != blank -%}
          {% # theme-check-disable ImgWidthAndHeight %}
          <img class="size-guide-modal__image" src="{{ size_guide_src }}" alt="Size guide for {{ product.title | escape }}" loading="lazy">
          {% # theme-check-enable ImgWidthAndHeight %}
        {%- endif -%}
      </div>
    </dialog>
  {%- endif -%}
</section>

{{ 'product.css' | asset_url | stylesheet_tag }}

{% schema %}
{
  "name": "Main product",
  "settings": [
    { "type": "header", "content": "Size guide" },
    { "type": "image_picker", "id": "size_guide_image", "label": "Size guide image" },
    { "type": "text", "id": "size_guide_file", "label": "Size guide filename", "default": "Size_guide.png", "info": "Used only when no image is picked above. Must match a file in Content > Files, including its extension. Leave both blank to show only the measurements table." },
    { "type": "text", "id": "size_guide_namespace", "label": "Measurement metafield namespace", "default": "Size_Guide", "info": "The namespace half of the variant metafield, i.e. the part before the dot in Size_Guide.Height." },
    { "type": "text", "id": "size_guide_keys", "label": "Measurement keys", "info": "Comma separated, e.g. Height, Chest, Sleeve. Prefix an entry with its own namespace if it differs, e.g. custom.size_guide_height. Setting this is the reliable path - leave it blank only if auto-detection is already finding the rows." },
    { "type": "checkbox", "id": "size_guide_debug", "label": "Show metafield debug info", "default": false, "info": "Prints the raw metafields of the first variant inside the popup so the namespace and keys can be confirmed. Turn off once the table is correct." }
  ]
}
{% endschema %}
